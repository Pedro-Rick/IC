import pandas as pd
import numpy as np
from pathlib import Path

# =========================
# CONFIG
# =========================
var = ["Jou", "Hys"]  # maiúsculo (usado nos arquivos)
motor = ["2D", "Nabla", "V"]
motor_TL = ["2D", "Nabla", "V"]

PATH = Path(__file__).resolve().parent
BASE_PATH = PATH.parents[2]


# =========================
# FUNÇÃO DE MÉTRICAS
# =========================
def compute_metrics(csv_path, metric_col):

    df = pd.read_csv(csv_path)

    # segurança contra NaN
    df = df.dropna(subset=[metric_col])

    # ordena
    df = df.sort_values(["epoch", "seed"])

    # =========================
    # STD por epoch
    # =========================
    std_por_epoch = df.groupby("epoch")[metric_col].std()

    # =========================
    # AREA DO STD (estabilidade ao longo do treino)
    # =========================
    area_std = np.trapz(std_por_epoch.values) / len(std_por_epoch)

    # =========================
    # STD últimas 10 epochs (pós-convergência)
    # =========================
    std_10 = std_por_epoch.tail(10).mean()

    # =========================
    # STD final (última epoch)
    # =========================
    std_final = std_por_epoch.iloc[-1]

    # =========================
    # MAPE geral (tudo)
    # =========================
    mape_geral = df[metric_col].mean()

    # =========================
    # ÚLTIMA EPOCH POR SEED
    # =========================
    df_final = df.loc[df.groupby("seed")["epoch"].idxmax()]
    final_mapes = df_final[metric_col].values

    # =========================
    # MÉTRICAS FINAIS
    # =========================
    media_final = np.mean(final_mapes)

    cv_final = std_final / media_final if media_final != 0 else np.nan

    mape_pior = np.max(final_mapes)
    mape_melhor = np.min(final_mapes)

    range_final = mape_pior - mape_melhor

    return (
        area_std,
        std_10,
        std_final,
        mape_geral,
        cv_final,
        range_final,
        mape_pior,
        media_final,
        mape_melhor
    )


# =========================
# LOOP PRINCIPAL
# =========================
for v in var:
    for m in motor:
        for tl in motor_TL:

            # evita comparar motor com ele mesmo
            if m == tl:
                continue

            # coluna em minúsculo
            metric_col = f"{v}_mape"

            files = {
                "Baseline": BASE_PATH / "results_patu" / m / f"motor_{m}_{v}_info_per_epochs.csv",
                "TL_arquitetura": BASE_PATH / "transferLearning" / "TL_results" / m / f"{m}_TL_{tl}" / f"{m}_TL_arq_{tl}_{v}_info.csv",
                "TL_pesos": BASE_PATH / "transferLearning" / "TL_results" / m / f"{m}_TL_{tl}" / f"{m}_TL_arq_wei_{tl}_{v}_info.csv"
            }

            OUTPUT_PATH = (
                BASE_PATH
                / "transferLearning"
                / "TL_results"
                / "1global_results"
                / f"grafic_metrics-{m}_TL_{tl}_{v}.csv"
            )

            results = []

            for nome_modelo, path in files.items():

                if not path.exists():
                    print(f"Arquivo não encontrado: {path}")
                    continue

                try:
                    metrics = compute_metrics(path, metric_col)
                    results.append([nome_modelo, *metrics])

                except Exception as e:
                    print(f"Erro ao processar {path}: {e}")

            # =========================
            # SALVAR CSV FINAL
            # =========================
            columns = [
                "modelo",
                "area_std",
                "std_10",
                "std_final",
                "mape_geral",
                "cv_final",
                "range",
                "mape_pior",
                "media_final",
                "mape_melhor"
            ]

            df_results = pd.DataFrame(results, columns=columns)

            OUTPUT_PATH.parent.mkdir(parents=True, exist_ok=True)
            df_results.to_csv(OUTPUT_PATH, index=False)

            print("\nResumo salvo em:", OUTPUT_PATH)
            print(df_results)