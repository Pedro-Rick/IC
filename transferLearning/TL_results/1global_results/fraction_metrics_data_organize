import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# =========================
# CONFIG
# =========================
var = ["Jou", "Hys"]
motor = ["2D", "Nabla", "V"]
motor_TL = ["2D", "Nabla", "V"]

PATH = Path(__file__).resolve().parent
BASE_PATH = PATH.parents[2]

# =========================
# MÉTRICAS
# =========================
def compute_metrics(mape_values):

    mape_values = np.array(mape_values)

    mape_mean = np.mean(mape_values)
    mape_std  = np.std(mape_values)

    mape_best  = np.min(mape_values)
    mape_worst = np.max(mape_values)

    range_val = mape_worst - mape_best

    cv = mape_std / mape_mean if mape_mean > 1e-8 else np.nan

    area_std = mape_std

    return [
        len(mape_values),
        mape_mean,
        mape_std,
        area_std,
        cv,
        range_val,
        mape_best,
        mape_worst
    ]

# =========================
# PROCESSAMENTO
# =========================
def process_fraction_file(csv_path, metric_col, label_prefix):

    df = pd.read_csv(csv_path)
    df = df.dropna(subset=[metric_col])

    results = []

    grouped = df.groupby("data_fraction")

    for frac, group in grouped:

        mape_values = group[metric_col].values
        metrics = compute_metrics(mape_values)

        results.append([
            label_prefix,
            frac,
            *metrics
        ])

    return results

# =========================
# PLOT
# =========================
def plot_fraction_curve(df, title, save_path):

    plt.figure(figsize=(8, 5))

    for modelo in df["modelo"].unique():

        df_model = df[df["modelo"] == modelo].copy()

        df_model = df_model.sort_values("data_fraction")

        x = df_model["data_fraction"].values
        y = df_model["mape_mean"].values
        std = df_model["mape_std"].values

        colors = {
            "Baseline": "black",
            "TL_arq": "blue",
            "TL_wei": "green"
        }

        plt.plot(x, y, marker='o', label=modelo, color=colors.get(modelo))
        plt.fill_between(x, y - std, y + std, alpha=0.2, color=colors.get(modelo))

    plt.xlabel("Data Fraction")
    plt.ylabel("MAPE Mean")
    plt.title(title)
    plt.legend()
    plt.grid(True)

    save_path.parent.mkdir(parents=True, exist_ok=True)
    plt.savefig(save_path, dpi=300)
    plt.close()

# =========================
# LOOP PRINCIPAL
# =========================
for v in var:
    for m in motor:
        for tl in motor_TL:

            if m == tl:
                continue

            metric_col = f"{v}_mape"

            baseline_path = BASE_PATH / "results_patu" / m / f"motor_{m}_{v}_info_percent.csv"

            frac_arq_path = BASE_PATH / "transferLearning" / "TL_results" / m / f"{m}_TL_{tl}" / f"percent_data_{m}_TL_arq_{tl}_{v}_info.csv"

            frac_wei_path = BASE_PATH / "transferLearning" / "TL_results" / m / f"{m}_TL_{tl}" / f"percent_data_{m}_TL_arq_wei_{tl}_{v}_info.csv"

            OUTPUT_GLOBAL = (
                BASE_PATH
                / "transferLearning"
                / "TL_results"
                / "1global_results"
                / "fraction_metrics"
                / f"fraction_metrics_{m}_TL_{tl}_{v}.csv"
            )

            PLOT_PATH = (
                BASE_PATH
                / "transferLearning"
                / "TL_results"
                / "1global_results"
                / "fraction_metrics"
                / "graficos"
                / f"plot_{m}_TL_{tl}_{v}.png"
            )

            results_global = []

            # =========================
            # BASELINE
            # =========================
            if baseline_path.exists():
                results_global.extend(
                    process_fraction_file(baseline_path, metric_col, "Baseline")
                )

            # =========================
            # TL ARQ
            # =========================
            if frac_arq_path.exists():
                results_global.extend(
                    process_fraction_file(frac_arq_path, metric_col, "TL_arq")
                )

            # =========================
            # TL WEI
            # =========================
            if frac_wei_path.exists():
                results_global.extend(
                    process_fraction_file(frac_wei_path, metric_col, "TL_wei")
                )

            # =========================
            # SALVAR CSV
            # =========================
            columns = [
                "modelo",
                "data_fraction",   # ✅ singular
                "n_seeds",
                "mape_mean",
                "mape_std",
                "area_std",
                "cv_final",
                "range",
                "mape_best",
                "mape_worst"
            ]

            df_global = pd.DataFrame(results_global, columns=columns)
            df_global["data_fraction"] = df_global["data_fraction"].astype(float)

            OUTPUT_GLOBAL.parent.mkdir(parents=True, exist_ok=True)
            df_global.to_csv(OUTPUT_GLOBAL, index=False)

            print("\nCSV salvo em:", OUTPUT_GLOBAL)

            # =========================
            # PLOT
            # =========================
            if not df_global.empty:
                title = f"{m} | TL from {tl} | {v}"
                plot_fraction_curve(df_global, title, PLOT_PATH)

                print("Plot salvo em:", PLOT_PATH)