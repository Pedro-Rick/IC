import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# =========================
# CONFIG
# =========================
var = ["Jou", "Hys"]
motor = ["2D", "Nabla", "V"]
motor_TL = ["2D", "Nabla", "V"]

PATH = Path(__file__).resolve().parent
BASE_PATH = PATH.parents[2]

# =========================
# MÉTRICAS
# =========================
def compute_metrics(mape_values):

    mape_values = np.array(mape_values)

    mape_mean = np.mean(mape_values)
    mape_std  = np.std(mape_values)

    mape_best  = np.min(mape_values)
    mape_worst = np.max(mape_values)

    range_val = mape_worst - mape_best

    cv = mape_std / mape_mean if mape_mean != 0 else np.nan

    area_std = mape_std

    return [
        len(mape_values),
        mape_mean,
        mape_std,
        area_std,
        cv,
        range_val,
        mape_best,
        mape_worst
    ]

# =========================
# PROCESSAMENTO
# =========================
def process_fraction_file(csv_path, metric_col, label_prefix):

    df = pd.read_csv(csv_path)
    df = df.dropna(subset=[metric_col])

    results = []

    grouped = df.groupby("data_fraction")

    for frac, group in grouped:

        mape_values = group[metric_col].values
        metrics = compute_metrics(mape_values)

        results.append([
            label_prefix,
            frac,
            *metrics
        ])

    return results

